<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0">
<title>You Won a Free Study Abroad Consultation - Step4Progress</title>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
*{box-sizing:border-box;margin:0;padding:0}
:root{
  --navy:#0D2137;
  --navy2:#163352;
  --navy3:#0A1929;
  --gold:#C9A84C;
  --gold2:#E8C96A;
  --cream:#F8F7F4;
  --ink:#1C1917;
  --ink2:#44403C;
  --ink3:#6B7280;
  --line:#E5E7EB;
  --font-h:'Playfair Display',Georgia,serif;
  --font-b:'Inter',system-ui,sans-serif;
}
html,body{min-height:100vh;font-family:var(--font-b);background:var(--cream);color:var(--ink)}

.hero{
  background:linear-gradient(160deg,var(--navy3) 0%,var(--navy) 55%,var(--navy2) 100%);
  min-height:100vh;
  display:flex;
  flex-direction:column;
  align-items:center;
  justify-content:center;
  padding:40px 20px 60px;
  position:relative;
  overflow:hidden;
}
.hero::before{
  content:'';
  position:absolute;
  inset:0;
  background:radial-gradient(ellipse 60% 50% at 25% 20%,rgba(201,168,76,.14) 0%,transparent 60%),
             radial-gradient(ellipse 50% 60% at 85% 80%,rgba(255,255,255,.04) 0%,transparent 55%);
  pointer-events:none;
}

.logo{
  font-family:var(--font-h);
  font-size:20px;
  font-weight:700;
  color:#fff;
  letter-spacing:-.01em;
  margin-bottom:36px;
  position:relative;z-index:1;
  animation:fadeIn .7s ease both;
}
.logo span{color:var(--gold2)}

.card{
  background:#fff;
  border-radius:16px;
  padding:36px 28px;
  width:100%;max-width:420px;
  box-shadow:0 24px 64px rgba(0,0,0,.25);
  position:relative;z-index:1;
  animation:fadeUp .6s ease .15s both;
}

.eyebrow{
  display:inline-flex;align-items:center;gap:6px;
  font-size:11px;font-weight:700;
  letter-spacing:.1em;text-transform:uppercase;
  color:var(--gold);
  padding:6px 14px;border-radius:99px;
  border:1px solid rgba(201,168,76,.35);
  margin-bottom:16px;
}
.card h1{
  font-family:var(--font-h);
  font-size:26px;font-weight:700;
  color:var(--navy);
  line-height:1.25;
  margin-bottom:10px;
  letter-spacing:-.01em;
}
.card h1 span{color:var(--gold)}
.card p{
  font-size:13.5px;color:var(--ink3);
  line-height:1.6;margin-bottom:26px;
}

.field{margin-bottom:15px}
.field label{
  display:block;
  font-size:11px;font-weight:600;
  color:var(--ink2);
  text-transform:uppercase;letter-spacing:.05em;
  margin-bottom:6px;
}
.field input{
  width:100%;
  padding:12px 14px;
  border:1.5px solid var(--line);
  border-radius:8px;
  font-size:14.5px;
  font-family:var(--font-b);
  color:var(--ink);
  background:var(--cream);
  outline:none;
  transition:border .15s,box-shadow .15s,background .15s;
  -webkit-appearance:none;appearance:none;
}
.field input:focus{
  border-color:var(--navy);
  box-shadow:0 0 0 3px rgba(13,33,55,.08);
  background:#fff;
}
.field input::placeholder{color:#C4C9D0}

.btn{
  width:100%;
  padding:15px;
  background:var(--navy);
  color:#fff;
  border:none;
  border-radius:8px;
  font-size:14.5px;font-weight:700;
  font-family:var(--font-b);
  cursor:pointer;
  margin-top:6px;
  transition:background .15s,transform .15s,box-shadow .15s;
  letter-spacing:.02em;
}
.btn:hover:not(:disabled){background:var(--navy2);transform:translateY(-1px);box-shadow:0 8px 20px rgba(13,33,55,.28)}
.btn:active:not(:disabled){transform:translateY(0)}
.btn:disabled{opacity:.6;cursor:not-allowed}

.trust{
  display:flex;align-items:center;justify-content:center;
  gap:14px;flex-wrap:wrap;
  margin-top:16px;
  padding-top:16px;
  border-top:1px solid var(--line);
}
.trust-item{
  font-size:11px;color:var(--ink3);
  display:flex;align-items:center;gap:4px;
}

.phone-link{
  display:block;
  text-align:center;
  margin-top:12px;
  font-size:12px;color:var(--ink3);
}
.phone-link a{color:var(--navy);font-weight:700;text-decoration:none}

.error-msg{
  font-size:11.5px;color:#DC2626;
  margin-top:5px;display:none;
}

.bottom{
  text-align:center;
  margin-top:26px;
  position:relative;z-index:1;
  animation:fadeIn .8s ease .3s both;
}
.bottom a{
  color:rgba(255,255,255,.45);
  font-size:12px;text-decoration:none;
}
.bottom a:hover{color:var(--gold2)}

/* ── WIN POPUP ── */
.overlay{
  display:none;
  position:fixed;
  inset:0;
  background:rgba(10,25,41,.72);
  z-index:100;
  align-items:center;
  justify-content:center;
  padding:20px;
  animation:fadeIn .25s ease both;
}
.win-popup{
  background:#fff;
  border-radius:18px;
  padding:40px 28px;
  max-width:380px;
  width:100%;
  text-align:center;
  box-shadow:0 30px 80px rgba(0,0,0,.4);
  animation:popIn .35s cubic-bezier(.2,.9,.3,1.3) both;
  position:relative;
  overflow:hidden;
}
.win-popup::before{
  content:'';
  position:absolute;
  top:-40%;left:-20%;
  width:140%;height:180%;
  background:radial-gradient(circle,rgba(201,168,76,.12) 0%,transparent 60%);
  pointer-events:none;
}
.win-ring{
  width:80px;height:80px;
  background:linear-gradient(135deg,var(--gold),var(--gold2));
  border-radius:50%;
  display:flex;align-items:center;justify-content:center;
  margin:0 auto 20px;
  font-size:36px;
  box-shadow:0 10px 30px rgba(201,168,76,.4);
}
.win-popup h2{
  font-family:var(--font-h);
  font-size:24px;font-weight:700;
  color:var(--navy);
  line-height:1.3;
  margin-bottom:12px;
}
.win-popup h2 span{color:var(--gold)}
.win-popup p{
  font-size:13.5px;color:var(--ink3);
  line-height:1.6;margin-bottom:22px;
}
.win-badge{
  display:inline-flex;align-items:center;gap:6px;
  background:var(--navy);color:var(--gold2);
  font-size:11px;font-weight:700;
  padding:8px 18px;border-radius:99px;
  letter-spacing:.04em;
  margin-bottom:20px;
}
.win-close{
  width:100%;
  padding:14px;
  background:var(--navy);
  color:#fff;
  border:none;
  border-radius:8px;
  font-size:14px;font-weight:700;
  font-family:var(--font-b);
  cursor:pointer;
  letter-spacing:.02em;
}
.win-close:hover{background:var(--navy2)}

@keyframes fadeUp{from{opacity:0;transform:translateY(18px)}to{opacity:1;transform:translateY(0)}}
@keyframes fadeIn{from{opacity:0}to{opacity:1}}
@keyframes popIn{from{opacity:0;transform:scale(.85) translateY(10px)}to{opacity:1;transform:scale(1) translateY(0)}}

@media(max-width:440px){
  .card{padding:28px 20px;border-radius:14px}
  .card h1{font-size:22px}
  .win-popup{padding:32px 22px}
}
</style>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "EducationalOrganization",
  "name": "Step4Progress India",
  "alternateName": "Step4Progress",
  "url": "https://step4progress.com",
  "description": "Study abroad consultancy based in Madurai, Tamil Nadu, helping South Indian students with university applications, visas, and scholarships for the UK, USA, Canada, Australia, Europe, and more.",
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Madurai",
    "addressRegion": "Tamil Nadu",
    "addressCountry": "IN"
  },
  "areaServed": ["Tamil Nadu", "South India", "India"],
  "sameAs": [
    "https://www.facebook.com/STEP4PROGRESS1/",
    "https://uk.linkedin.com/company/step4progress1",
    "https://www.instagram.com/step4progress/",
    "https://www.youtube.com/@step4progress-he1kw"
  ]
}
</script>
</head>
<body>

<div class="hero">

  <div class="logo">Step4Progress <span>India</span></div>

  <div class="card" id="form-card">
    <div class="eyebrow">🎓 Free Consultation</div>
    <h1>Study Abroad?<br>Let's make it <span>happen.</span></h1>
    <p>Fill in your details - our expert counsellor will call you back within 24 hours. Completely free.</p>

    <div class="field">
      <label>Your name</label>
      <input type="text" id="f-name" placeholder="Full name" autocomplete="name">
      <div class="error-msg" id="err-name">Please enter your name</div>
    </div>

    <div class="field">
      <label>Mobile number</label>
      <input type="tel" id="f-mobile" placeholder="+91 98765 43210" autocomplete="tel">
      <div class="error-msg" id="err-mobile">Please enter a valid mobile number</div>
    </div>

    <div class="field">
      <label>City</label>
      <input type="text" id="f-city" placeholder="e.g. Madurai, Chennai…" autocomplete="address-level2">
    </div>

    <div class="field">
      <label>Desired course</label>
      <input type="text" id="f-course" placeholder="e.g. MBA, MS Computer Science…">
    </div>

    <div class="field">
      <label>Qualification</label>
      <input type="text" id="f-qualification" placeholder="e.g. B.Sc, B.E, 12th…">
    </div>

    <div class="field">
      <label>Desired country</label>
      <input type="text" id="f-country" placeholder="e.g. UK, Canada, Australia…">
    </div>

    <div class="error-msg" id="err-submit" style="margin-bottom:8px;font-size:13px">Something went wrong. Please try again or call us directly on +91 915 915 8881.</div>

    <button class="btn" id="submit-btn" onclick="submitLead()">
      <span id="btn-text">Submit &amp; Claim My Free Session →</span>
    </button>

    <div class="trust">
      <div class="trust-item">✅ 100% Free</div>
      <div class="trust-item">📞 Call within 24hrs</div>
      <div class="trust-item">🔒 Your data is safe</div>
    </div>

    <div class="phone-link">
      Prefer to call? <a href="tel:+919159158881">+91 915 915 8881</a>
    </div>
  </div>

  <div class="bottom">
    <a href="https://step4progress.com">step4progress.com</a>
  </div>

</div>

<!-- WIN POPUP -->
<div class="overlay" id="win-overlay">
  <div class="win-popup">
    <div class="win-ring">🎉</div>
    <h2>Congratulations, you won a <span>free study abroad counselling!</span></h2>
    <p>Our expert counsellor will call you within 24 hours to get your session started.</p>
    <div class="win-badge">✅ Callback confirmed</div>
    <button class="win-close" onclick="closeWinPopup()">Awesome, got it!</button>
  </div>
</div>

<script>
// Unregister CRM service worker so it doesn't intercept our fetch
if ('serviceWorker' in navigator) {
  navigator.serviceWorker.getRegistrations().then(regs => {
    regs.forEach(reg => reg.unregister());
  });
}

const EDGE = 'https://jvreglqrrdnwttjasvwg.supabase.co/functions/v1/tally-webhook';

async function submitLead() {
  const name = document.getElementById('f-name').value.trim();
  const mobile = document.getElementById('f-mobile').value.trim();
  const city = document.getElementById('f-city').value.trim();
  const course = document.getElementById('f-course').value.trim();
  const qualification = document.getElementById('f-qualification').value.trim();
  const country = document.getElementById('f-country').value.trim();

  // Validate
  let valid = true;
  document.getElementById('err-name').style.display = name ? 'none' : 'block';
  document.getElementById('err-mobile').style.display = mobile.length >= 7 ? 'none' : 'block';
  document.getElementById('err-submit').style.display = 'none';
  if (!name) valid = false;
  if (mobile.length < 7) valid = false;
  if (!valid) return;

  const btn = document.getElementById('submit-btn');
  document.getElementById('btn-text').textContent = 'Submitting…';
  btn.disabled = true;

  const payload = {
    data: {
      fields: [
        { label: 'Full Name', value: name },
        { label: 'Mobile Number', value: mobile },
        { label: 'City Native', value: city },
        { label: 'Program Interest', value: course },
        { label: 'Qualification', value: qualification },
        { label: 'Destination Country', value: country || 'Not decided yet' },
        { label: 'Nationality', value: 'India' },
        { label: 'How Did You Find Us', value: 'Won a Free Consultation Promo' },
        { label: 'Source', value: 'Won a Free Consultation Promo' }
      ]
    }
  };

  try {
    const res = await fetch(EDGE, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload),
      cache: 'no-store'
    });
    if (!res.ok) throw new Error('Server error ' + res.status);
    const data = await res.json();
    console.log('Lead created:', data);

    // Show win popup over the form
    document.getElementById('win-overlay').style.display = 'flex';
    document.getElementById('btn-text').textContent = 'Submitted ✓';

  } catch (err) {
    console.error(err);
    document.getElementById('err-submit').style.display = 'block';
    document.getElementById('btn-text').textContent = 'Submit & Claim My Free Session →';
    btn.disabled = false;
  }
}

function closeWinPopup() {
  document.getElementById('win-overlay').style.display = 'none';
}

// Enter key submits (only when not inside the popup)
document.addEventListener('keydown', e => {
  if (e.key === 'Enter' && document.getElementById('win-overlay').style.display !== 'flex') {
    submitLead();
  }
});
</script>
</body>
</html>
