<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Scholarship Finder — Step4Progress (Internal Prototype)</title>
<style>
  :root{
    --ink:#132A3A;
    --ink-2:#1D3E54;
    --paper:#FBF9F4;
    --paper-dim:#F0ECE1;
    --brass:#C89B3C;
    --brass-dim:#8F6C24;
    --teal:#2F5D50;
    --teal-dim:#254A40;
    --rose:#B14A3E;
    --line:#D9D2BE;
    --ok:#2F5D50;
    --warn:#B8862E;
    --unver:#8A5A4A;
    --radius:14px;
    --font-display: 'Fraunces', Georgia, serif;
    --font-body: 'IBM Plex Sans', -apple-system, Segoe UI, sans-serif;
    --font-mono: 'IBM Plex Mono', 'Courier New', monospace;
  }

  @font-face{font-family:'Fraunces';src:local('Fraunces');}
  @import url('https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,600;9..144,700&family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap');

  *{box-sizing:border-box;}
  body{
    margin:0;
    background:var(--ink);
    background-image:
      radial-gradient(circle at 15% 8%, rgba(200,155,60,0.10), transparent 45%),
      radial-gradient(circle at 85% 92%, rgba(47,93,80,0.18), transparent 50%);
    color:var(--paper);
    font-family:var(--font-body);
    line-height:1.5;
    min-height:100vh;
  }

  .wrap{max-width:1100px;margin:0 auto;padding:40px 24px 80px;}

  /* ---------- Header ---------- */
  header.hero{
    display:flex;
    flex-wrap:wrap;
    justify-content:space-between;
    align-items:flex-end;
    gap:24px;
    border-bottom:1px solid rgba(251,249,244,0.18);
    padding-bottom:28px;
    margin-bottom:28px;
  }
  .eyebrow{
    font-family:var(--font-mono);
    font-size:12px;
    letter-spacing:.14em;
    text-transform:uppercase;
    color:var(--brass);
    margin:0 0 10px;
  }
  h1{
    font-family:var(--font-display);
    font-weight:700;
    font-size:clamp(28px,4vw,44px);
    line-height:1.05;
    margin:0 0 8px;
    color:var(--paper);
  }
  .hero p.sub{
    margin:0;
    max-width:56ch;
    color:rgba(251,249,244,0.72);
    font-size:15px;
  }
  .status-pill{
    font-family:var(--font-mono);
    font-size:11.5px;
    letter-spacing:.03em;
    background:rgba(47,93,80,0.35);
    border:1px solid var(--teal);
    color:#CFE3DB;
    padding:7px 12px;
    border-radius:999px;
    white-space:nowrap;
  }

  /* ---------- Lead auto-fill bar ---------- */
  .lead-bar{
    background:rgba(251,249,244,0.06);
    border:1px dashed rgba(200,155,60,0.5);
    border-radius:var(--radius);
    padding:16px 18px;
    margin-bottom:24px;
    display:flex;
    flex-wrap:wrap;
    gap:14px;
    align-items:center;
  }
  .lead-bar label{
    font-family:var(--font-mono);
    font-size:12px;
    color:var(--brass);
    text-transform:uppercase;
    letter-spacing:.06em;
  }
  .lead-bar select{
    background:var(--ink-2);
    color:var(--paper);
    border:1px solid rgba(251,249,244,0.25);
    border-radius:8px;
    padding:8px 10px;
    font-family:var(--font-body);
    font-size:13.5px;
  }
  .lead-bar .note{
    font-size:12.5px;
    color:rgba(251,249,244,0.55);
    flex-basis:100%;
  }
  .lead-bar button.clear{
    background:none;
    border:1px solid rgba(251,249,244,0.3);
    color:var(--paper);
    border-radius:8px;
    padding:8px 12px;
    font-size:12.5px;
    cursor:pointer;
  }
  .lead-bar button.clear:hover{border-color:var(--rose);color:#F0B4A9;}

  /* ---------- Filters ---------- */
  .filters{
    background:var(--paper);
    color:var(--ink);
    border-radius:var(--radius);
    padding:20px;
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(160px,1fr));
    gap:14px;
    margin-bottom:26px;
    box-shadow:0 12px 30px rgba(0,0,0,0.25);
  }
  .field-group{display:flex;flex-direction:column;gap:6px;}
  .field-group label{
    font-family:var(--font-mono);
    font-size:11px;
    letter-spacing:.06em;
    text-transform:uppercase;
    color:var(--teal-dim);
  }
  .field-group select, .field-group input[type="text"]{
    border:1px solid var(--line);
    border-radius:8px;
    padding:9px 10px;
    font-family:var(--font-body);
    font-size:13.5px;
    background:#fff;
    color:var(--ink);
  }
  .filters .actions{
    display:flex;
    align-items:flex-end;
  }
  .filters .actions button{
    width:100%;
    background:var(--ink);
    color:var(--paper);
    border:none;
    border-radius:8px;
    padding:10px 12px;
    font-family:var(--font-body);
    font-size:13.5px;
    font-weight:600;
    cursor:pointer;
  }
  .filters .actions button:hover{background:var(--teal-dim);}

  .results-meta{
    display:flex;
    justify-content:space-between;
    align-items:baseline;
    margin-bottom:16px;
    color:rgba(251,249,244,0.75);
    font-size:13.5px;
  }
  .results-meta strong{color:var(--paper);}

  /* ---------- Ticket / stub cards ---------- */
  .grid{display:grid;grid-template-columns:1fr;gap:20px;}
  @media(min-width:760px){.grid{grid-template-columns:1fr 1fr;}}

  .ticket{
    background:var(--paper);
    color:var(--ink);
    border-radius:var(--radius);
    display:grid;
    grid-template-columns:1fr 108px;
    overflow:hidden;
    box-shadow:0 14px 34px rgba(0,0,0,0.28);
    position:relative;
  }
  .ticket .main{padding:20px 18px 18px;}
  .ticket .stub{
    background:var(--ink);
    color:var(--paper);
    padding:16px 10px;
    display:flex;
    flex-direction:column;
    align-items:center;
    justify-content:center;
    text-align:center;
    gap:6px;
    position:relative;
  }
  /* perforation effect between main and stub */
  .ticket .stub::before{
    content:"";
    position:absolute;
    left:0;top:0;bottom:0;
    width:0;
    border-left:2px dashed rgba(251,249,244,0.35);
  }
  .ticket .stub .badge-circle{
    width:44px;height:44px;
    border-radius:50%;
    border:2px solid var(--brass);
    display:flex;align-items:center;justify-content:center;
    font-size:19px;
  }
  .ticket .stub .stamp-label{
    font-family:var(--font-mono);
    font-size:10px;
    letter-spacing:.05em;
    text-transform:uppercase;
    color:var(--brass);
  }
  .ticket .stub .deadline{
    font-family:var(--font-mono);
    font-size:12px;
    line-height:1.35;
    color:var(--paper);
  }

  .name-row{display:flex;justify-content:space-between;gap:8px;align-items:flex-start;}
  .ticket h3{
    font-family:var(--font-display);
    font-size:19px;
    margin:0 0 3px;
    line-height:1.2;
  }
  .provider{
    font-size:12px;
    color:var(--teal-dim);
    font-weight:600;
    text-transform:uppercase;
    letter-spacing:.03em;
    margin-bottom:10px;
  }
  .tags{display:flex;flex-wrap:wrap;gap:6px;margin-bottom:12px;}
  .tag{
    font-family:var(--font-mono);
    font-size:10.5px;
    padding:3px 8px;
    border-radius:999px;
    border:1px solid var(--line);
    color:var(--ink-2);
    white-space:nowrap;
  }
  .tag.category{background:#EFE7D2;border-color:#D8C68F;color:var(--brass-dim);}
  .tag.gender{background:#F3E2DE;border-color:#E0B7AE;color:var(--rose);}
  .tag.popularity-gem{background:#E1EEE9;border-color:#B9D8CC;color:var(--teal-dim);}
  .tag.popularity-known{background:#E8E3F2;border-color:#CBC0E6;color:#5B4A8A;}

  .fund-summary{font-size:13.5px;margin-bottom:10px;}
  .fund-summary strong{color:var(--ink);}

  details.elig{margin-bottom:10px;}
  details.elig summary{
    cursor:pointer;
    font-size:12.5px;
    color:var(--teal-dim);
    font-weight:600;
  }
  details.elig ul{margin:8px 0 0;padding-left:18px;font-size:13px;color:#3A3A34;}
  details.elig li{margin-bottom:4px;}

  .card-footer{
    display:flex;
    justify-content:space-between;
    align-items:center;
    border-top:1px dashed var(--line);
    padding-top:10px;
    margin-top:6px;
  }
  .source-note{font-size:11px;color:#7A7566;font-family:var(--font-mono);}
  .source-note .verified{color:var(--ok);}
  .source-note .partial{color:var(--warn);}
  a.official-link{
    font-size:12.5px;
    font-weight:600;
    color:var(--teal-dim);
    text-decoration:none;
    border-bottom:1px solid var(--teal-dim);
    white-space:nowrap;
  }
  a.official-link:hover{color:var(--rose);border-color:var(--rose);}

  .empty-state{
    text-align:center;
    padding:60px 20px;
    color:rgba(251,249,244,0.6);
    font-family:var(--font-mono);
    font-size:13.5px;
  }

  /* ---------- Verification log ---------- */
  .verify-section{margin-top:48px;}
  .verify-section > summary{
    cursor:pointer;
    font-family:var(--font-mono);
    font-size:12.5px;
    letter-spacing:.05em;
    text-transform:uppercase;
    color:var(--brass);
    margin-bottom:12px;
  }
  table.verify-table{
    width:100%;
    border-collapse:collapse;
    background:var(--paper);
    color:var(--ink);
    border-radius:10px;
    overflow:hidden;
    font-size:12.5px;
  }
  table.verify-table th, table.verify-table td{
    text-align:left;
    padding:9px 10px;
    border-bottom:1px solid var(--line);
  }
  table.verify-table th{
    background:var(--paper-dim);
    font-family:var(--font-mono);
    font-size:11px;
    text-transform:uppercase;
    letter-spacing:.04em;
  }
  .status-ok{color:var(--ok);font-weight:600;}
  .status-partial{color:var(--warn);font-weight:600;}

  footer.page-footer{
    margin-top:40px;
    padding-top:20px;
    border-top:1px solid rgba(251,249,244,0.15);
    font-size:12px;
    color:rgba(251,249,244,0.5);
  }

  @media (prefers-reduced-motion:no-preference){
    .ticket{transition:transform .15s ease, box-shadow .15s ease;}
    .ticket:hover{transform:translateY(-2px);box-shadow:0 18px 40px rgba(0,0,0,0.34);}
  }
</style>
</head>
<body>
<div class="wrap">

  <header class="hero">
    <div>
      <p class="eyebrow">Step4Progress CRM &middot; Internal Assessment Prototype</p>
      <h1>Scholarship Finder</h1>
      <p class="sub">A standalone lookup tool for genuine, currently-active scholarships — filterable by destination, degree level, field, category and gender eligibility. Built so it can be dropped into the CRM's Leads module later with minimal rework.</p>
    </div>
    <div class="status-pill">10 scholarships &middot; sources checked Jul 2026</div>
  </header>

  <div class="lead-bar">
    <label for="leadSelect">Load from lead (demo)</label>
    <select id="leadSelect">
      <option value="">— select a sample lead —</option>
    </select>
    <button class="clear" id="clearLead" type="button">Clear</button>
    <span class="note">This dropdown uses hardcoded sample leads for the prototype. In the live CRM, it will read the selected lead's destination, degree level, field and gender directly from the <code>leads</code> table — see the code comments near <code>SAMPLE_LEADS</code>.</span>
  </div>

  <div class="filters">
    <div class="field-group">
      <label for="fDestination">Destination</label>
      <select id="fDestination"><option value="">Any</option></select>
    </div>
    <div class="field-group">
      <label for="fDegree">Degree level</label>
      <select id="fDegree"><option value="">Any</option></select>
    </div>
    <div class="field-group">
      <label for="fGender">Gender eligibility</label>
      <select id="fGender"><option value="">Any</option></select>
    </div>
    <div class="field-group">
      <label for="fCategory">Category</label>
      <select id="fCategory"><option value="">Any</option></select>
    </div>
    <div class="field-group">
      <label for="fPopularity">Popularity</label>
      <select id="fPopularity"><option value="">Any</option></select>
    </div>
    <div class="field-group">
      <label for="fSearch">Field / keyword</label>
      <input type="text" id="fSearch" placeholder="e.g. public health, arts">
    </div>
    <div class="field-group actions">
      <button id="resetFilters" type="button">Reset filters</button>
    </div>
  </div>

  <div class="results-meta">
    <span><strong id="resultCount">10</strong> scholarships match</span>
    <span>Sorted by relevance</span>
  </div>

  <div class="grid" id="resultsGrid"></div>
  <div class="empty-state" id="emptyState" style="display:none;">No scholarships match this combination of filters — try widening the destination or degree level.</div>

  <details class="verify-section">
    <summary>Verification log — how each fact was checked</summary>
    <table class="verify-table">
      <thead>
        <tr><th>Scholarship</th><th>Claim checked</th><th>Status</th><th>Source</th><th>Notes</th></tr>
      </thead>
      <tbody id="verifyBody"></tbody>
    </table>
  </details>

  <footer class="page-footer">
    Prototype for internal review only — not yet wired to Supabase or the Leads module. Figures and deadlines move yearly; the "checked" date on each card shows when it was last confirmed against the official source. Always re-verify before sharing a specific deadline with a student.
  </footer>

</div>

