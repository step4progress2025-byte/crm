/* =========================================================================
   SAMPLE LEADS (demo only)
   ---------------------------------------------------------------------
   Stand-in for the real Leads module. In the CRM build, replace this array
   and loadLead() with a Supabase call, e.g.:
     const { data } = await supabase.from('leads')
       .select('id, name, destination_country, degree_level, field_of_study, gender, branch')
       .eq('branch', currentBranch);
   The shape below already matches that target schema so the filter-mapping
   logic in applyLead() should not need to change.
   ========================================================================= */
const SAMPLE_LEADS = [
  { id:"L-1042", name:"Aditi R. (Coimbatore)", destination:"UK", degreeLevel:"Master's", field:"public health", gender:"Women only", branch:"India" },
  { id:"L-1088", name:"Rohan K. (Pune)", destination:"USA", degreeLevel:"Master's", field:"economics", gender:"All genders", branch:"India" },
  { id:"L-1123", name:"Farah S. (London)", destination:"Germany", degreeLevel:"PhD", field:"", gender:"All genders", branch:"UK" },
  { id:"L-1156", name:"Devansh P. (Ahmedabad)", destination:"UK", degreeLevel:"Master's", field:"heritage conservation", gender:"All genders", branch:"India" }
];

/* ---------------------------------------------------------------------- */

const els = {
  destination: document.getElementById('fDestination'),
  degree: document.getElementById('fDegree'),
  gender: document.getElementById('fGender'),
  category: document.getElementById('fCategory'),
  popularity: document.getElementById('fPopularity'),
  search: document.getElementById('fSearch'),
  grid: document.getElementById('resultsGrid'),
  empty: document.getElementById('emptyState'),
  count: document.getElementById('resultCount'),
  leadSelect: document.getElementById('leadSelect'),
  clearLead: document.getElementById('clearLead'),
  verifyBody: document.getElementById('verifyBody'),
  resetBtn: document.getElementById('resetFilters')
};

function uniqueValues(list, getter){
  const set = new Set();
  list.forEach(item => {
    const v = getter(item);
    if(Array.isArray(v)){ v.forEach(x=>set.add(x)); } else if(v){ set.add(v); }
  });
  return Array.from(set).sort();
}

function populateSelect(select, values){
  values.forEach(v=>{
    const opt = document.createElement('option');
    opt.value = v; opt.textContent = v;
    select.appendChild(opt);
  });
}

function init(){
  populateSelect(els.destination, uniqueValues(SCHOLARSHIPS, s=>s.destination));
  populateSelect(els.degree, uniqueValues(SCHOLARSHIPS, s=>s.degreeLevels));
  populateSelect(els.gender, ["All genders","Women only"]);
  populateSelect(els.category, uniqueValues(SCHOLARSHIPS, s=>s.category));
  populateSelect(els.popularity, ["Well-known","Moderately known","Underrated gem"]);

  SAMPLE_LEADS.forEach(l=>{
    const opt = document.createElement('option');
    opt.value = l.id; opt.textContent = `${l.name} — ${l.destination}, ${l.degreeLevel}`;
    els.leadSelect.appendChild(opt);
  });

  [els.destination, els.degree, els.gender, els.category, els.popularity].forEach(sel=>{
    sel.addEventListener('change', render);
  });
  els.search.addEventListener('input', render);
  els.resetBtn.addEventListener('click', resetFilters);
  els.leadSelect.addEventListener('change', onLeadChange);
  els.clearLead.addEventListener('click', ()=>{ els.leadSelect.value=""; resetFilters(); });

  buildVerifyLog();
  render();
}

function resetFilters(){
  els.destination.value = "";
  els.degree.value = "";
  els.gender.value = "";
  els.category.value = "";
  els.popularity.value = "";
  els.search.value = "";
  render();
}

function onLeadChange(){
  const lead = SAMPLE_LEADS.find(l=>l.id===els.leadSelect.value);
  if(!lead) return;
  // Auto-fill filters from the lead's profile — this is the "auto-fill from a
  // selected lead" behaviour, simulated here with SAMPLE_LEADS.
  els.destination.value = uniqueValues(SCHOLARSHIPS, s=>s.destination).includes(lead.destination) ? lead.destination : "";
  els.degree.value = lead.degreeLevel || "";
  els.gender.value = lead.gender || "";
  els.category.value = "";
  els.popularity.value = "";
  els.search.value = lead.field || "";
  render();
}

function matches(s){
  const dest = els.destination.value;
  const degree = els.degree.value;
  const gender = els.gender.value;
  const category = els.category.value;
  const popularity = els.popularity.value;
  const search = els.search.value.trim().toLowerCase();

  if(dest && s.destination !== dest) return false;
  if(degree && !s.degreeLevels.includes(degree)) return false;
  if(gender && s.genderEligibility.indexOf(gender) === -1 && !(gender==="All genders" && s.genderEligibility.indexOf("All genders")>-1)) return false;
  if(category && s.category !== category) return false;
  if(popularity && s.popularity !== popularity) return false;
  if(search){
    const haystack = (s.name + " " + s.fields.join(" ") + " " + s.fundingSummary + " " + s.eligibility.join(" ")).toLowerCase();
    if(haystack.indexOf(search) === -1) return false;
  }
  return true;
}

function popularityTagClass(p){
  if(p === "Underrated gem") return "popularity-gem";
  if(p === "Well-known" || p === "Moderately known") return "popularity-known";
  return "";
}

function flagFor(destination){
  if(destination.includes("UK")) return "🇬🇧";
  if(destination.includes("USA")) return "🇺🇸";
  if(destination.includes("Germany")) return "🇩🇪";
  return "🌍";
}

function renderCard(s){
  const el = document.createElement('article');
  el.className = 'ticket';

  const genderTag = s.genderEligibility.includes('Women') ? `<span class="tag gender">${s.genderEligibility}</span>` : '';

  el.innerHTML = `
    <div class="main">
      <div class="name-row">
        <div>
          <h3>${s.name}</h3>
          <div class="provider">${s.provider}</div>
        </div>
      </div>
      <div class="tags">
        <span class="tag category">${s.category}</span>
        <span class="tag ${popularityTagClass(s.popularity)}">${s.popularity}</span>
        ${genderTag}
      </div>
      <div class="fund-summary"><strong>${s.fundingType}.</strong> ${s.fundingSummary}</div>
      <details class="elig">
        <summary>Eligibility snapshot</summary>
        <ul>${s.eligibility.map(e=>`<li>${e}</li>`).join('')}</ul>
      </details>
      <div class="card-footer">
        <span class="source-note">Source: ${s.sourceName} &middot;
          <span class="${s.sourceStatus === 'verified' ? 'verified' : 'partial'}">${s.sourceStatus === 'verified' ? 'verified' : 'partially verified'}</span>
          &middot; checked ${s.sourceChecked}</span>
        <a class="official-link" href="${s.officialUrl}" target="_blank" rel="noopener">Official page →</a>
      </div>
    </div>
    <div class="stub">
      <div class="badge-circle">${flagFor(s.destination)}</div>
      <div class="stamp-label">Deadline</div>
      <div class="deadline">${s.deadlineInfo}</div>
    </div>
  `;
  return el;
}

function render(){
  const filtered = SCHOLARSHIPS.filter(matches);
  els.grid.innerHTML = '';
  els.count.textContent = filtered.length;
  els.empty.style.display = filtered.length ? 'none' : 'block';
  filtered.forEach(s => els.grid.appendChild(renderCard(s)));
}

function buildVerifyLog(){
  const rows = SCHOLARSHIPS.map(s => `
    <tr>
      <td>${s.name}</td>
      <td>Funding amount &amp; current deadline window</td>
      <td class="${s.sourceStatus==='verified' ? 'status-ok' : 'status-partial'}">${s.sourceStatus==='verified' ? '✅ Verified' : '⚠️ Partially verified'}</td>
      <td>${s.sourceName}</td>
      <td>Checked ${s.sourceChecked}${s.sourceStatus!=='verified' ? ' — exact dates vary by award type, confirm before quoting' : ''}</td>
    </tr>
  `).join('');
  els.verifyBody.innerHTML = rows;
}

